// The showcase at stringless.baselashraf.com, served as Workers static assets.
// Deploy: node site/build.mjs, then npx wrangler@4.168.0 deploy
{
  "name": "stringless",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "./site/dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "stringless.baselashraf.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
